# --- Claude (Anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- PayPal sandbox ---
# Create a sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave both empty to run in MOCK mode (no PayPal calls, simulated data).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- App ---
PORT=3000
# Public URL of this server (used for checkout + PayPal return links)
PUBLIC_URL=http://localhost:3000
BUSINESS_NAME=Acme Design Studio
